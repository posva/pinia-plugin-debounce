{
  "name": "@pinia/plugin-debounce",
  "packageManager": "pnpm@12.4.1",
  "version": "2.0.0",
  "type": "module",
  "description": "Debounce any action in your pinia 🍍 store!",
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "sideEffects": false,
  "funding": "https://github.com/sponsors/posva",
  "author": {
    "name": "Eduardo San Martin Morote",
    "email": "posva13@gmail.com"
  },
  "scripts": {
    "dev": "vitest",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "pnpm run build",
    "release": "node scripts/release.ts",
    "size": "size-limit",
    "test": "pnpm run build && pnpm run test:cov && pnpm run test:types",
    "lint": "oxlint ${CI:+--deny-warnings} .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt",
    "test:types": "tsc --build ./tsconfig.json",
    "test:cov": "vitest run --coverage",
    "build": "tsdown"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "pinia",
    "plugin",
    "debounce",
    "example",
    "starter",
    "boilerplate"
  ],
  "license": "MIT",
  "devDependencies": {
    "@posva/prompts": "^2.4.4",
    "@size-limit/esbuild-why": "^13.1.1",
    "@size-limit/preset-small-lib": "^13.1.1",
    "@types/node": "^26.5.1",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.11",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-plugin-posva": "^0.0.2",
    "pinia": "^4.0.3",
    "semver": "^7.8.5",
    "simple-git-hooks": "^2.14.0",
    "size-limit": "^13.1.1",
    "ts-debounce": "^5.0.1",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.42"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "node scripts/verifyCommit.js"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --no-error-on-unmatched-pattern --fix"
    ]
  },
  "size-limit": [
    {
      "name": "everything from source",
      "path": "src/index.ts",
      "import": "*",
      "ignore": [
        "pinia"
      ]
    },
    {
      "name": "everything from dist",
      "path": "dist/index.mjs",
      "import": "*",
      "ignore": [
        "pinia"
      ]
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/posva/pinia-plugin-debounce.git"
  },
  "bugs": {
    "url": "https://github.com/posva/pinia-plugin-debounce/issues"
  },
  "homepage": "https://github.com/posva/pinia-plugin-debounce#readme"
}
